{
  "mcpServers": {
    "github": {
      "type": "url",
      "url": "https://mcp.github.com/mcp",
      "description": "GitHub \u2014 The-MDC org access"
    },
    "hermes": {
      "command": "hermes",
      "args": [
        "mcp",
        "serve"
      ],
      "description": "Hermes Agent \u2014 messaging bridge across 30+ platforms (stdio, requires hermes on PATH)"
    },
    "crawl4ai": {
      "type": "sse",
      "url": "http://127.0.0.1:11235/mcp/sse"
    },
    "atomicmemory": {
      "command": "npx",
      "args": [
        "-y",
        "@atomicmemory/mcp-server"
      ]
    }
  }
}
